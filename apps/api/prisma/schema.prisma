generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  description String?
  price       Int
  imageUrl    String?
  stock       Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}