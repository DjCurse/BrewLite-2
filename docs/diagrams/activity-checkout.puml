@startuml activity-checkout
skinparam backgroundColor white
title Activity Diagram - Quy trình Đặt hàng & Thanh toán (End-to-End)

|#LightYellow|Customer|
start
:Chọn món, Size, Topping & Thêm vào giỏ;
:Nhấn "Tiến hành Thanh toán";

|#LightCyan|Next.js UI|
:Kiểm tra trạng thái đăng nhập;

if (Đã đăng nhập?) then (Chưa đăng nhập)
    :Chuyển hướng trang Đăng nhập/Đăng ký;
    |#LightYellow|Customer|
    :Nhập thông tin xác thực;
    |#LightGreen|NestJS API|
    :POST /auth/login -> Cấp JWT Token;
endif

|#LightCyan|Next.js UI|
:Hiển thị trang Checkout (Áp mã KM / Chọn Ví MoMo QR, Thẻ);
|#LightYellow|Customer|
:Xác nhận đặt đơn & thanh toán;

|#LightGreen|NestJS API|
:POST /orders (Xác thực JWT & mở Transaction);
:Kiểm tra tồn kho (stockQuantity >= quantity);

if (Đủ số lượng tồn kho?) then (Hết hàng / Không đủ)
    :Rollback Transaction;
    |#LightCyan|Next.js UI|
    :Hiển thị thông báo "Sản phẩm không đủ tồn kho";
    |#LightYellow|Customer|
    :Điều chỉnh giỏ hàng;
    stop
else (Đủ hàng)
    |#LightGreen|NestJS API|
    :Trừ stockQuantity & Tạo Order (PENDING);
    :Commit Transaction;
    :POST /payments (Kiểm tra Idempotency-Key);

    |#LightPink|Payment Service|
    :Xử lý giao dịch Ví MoMo QR / Thẻ;

    if (Kết quả thanh toán?) then (Thất bại)
        :Trả về FAILED;
        |#LightGreen|NestJS API|
        :Lưu Payment (FAILED), giữ Order ở PENDING;
        |#LightCyan|Next.js UI|
        :Thông báo lỗi, giữ giỏ hàng để thử lại;
        |#LightYellow|Customer|
        :Thử thanh toán lại / Hủy;
        stop
    else (Thành công)
        |#LightPink|Payment Service|
        :Trả về SUCCESS (Transaction ID);
        |#LightGreen|NestJS API|
        :Cập nhật Order -> PAID & Payment -> SUCCESS;
        :Ghi nhận LoyaltyTransaction (Cộng điểm);
        |#LightCyan|Next.js UI|
        :Xóa giỏ hàng & Hiển thị xác nhận / theo dõi đơn;
        |#LightYellow|Customer|
        :Theo dõi trạng thái đơn hàng;
        stop
    endif
endif
@enduml