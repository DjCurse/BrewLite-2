@startuml class-diagram
title Class Diagram - Domain Model (BrewLite System)
skinparam backgroundColor white

enum OrderStatus {
    PENDING
    CONFIRMED
    PREPARING
    READY
    COMPLETED
    PAID
    PAYMENT_FAILED
    CANCELLED
}

enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
    REFUNDED
}

enum PaymentMethod {
    WALLET
    CARD
    QR_CODE
    CASH
}

enum PromotionType {
    PERCENTAGE
    FIXED_AMOUNT
}

enum LoyaltyType {
    EARN
    REDEEM
}

class User {
    + String id
    + String email
    + String name
    + String passwordHash
    + String role
    + Int loyaltyPoints
    + DateTime createdAt
}

class Product {
    + String id
    + String name
    + String category
    + String description
    + Int price
    + String imageUrl
    + Int stockQuantity
    + Boolean isActive
}

class Order {
    + String id
    + String userId
    + String? promotionId
    + Int totalAmount
    + Int discountAmount
    + Int finalAmount
    + OrderStatus status
    + String idempotencyKey
    + DateTime createdAt
}

class OrderItem {
    + String id
    + String orderId
    + String productId
    + String size
    + String[] toppings
    + Int quantity
    + Int unitPrice
    + Int totalPrice
}

class Payment {
    + String id
    + String orderId
    + String transactionId
    + PaymentMethod method
    + PaymentStatus status
    + Int amount
    + DateTime paidAt
}

class Promotion {
    + String id
    + String code
    + PromotionType type
    + Int value
    + Int minOrderValue
    + Boolean staffOnly
    + Int? maxUses
    + Int usedCount
    + Int? perUserLimit
    + DateTime startDate
    + DateTime endDate
    + Boolean isActive
}

class LoyaltyTransaction {
    + String id
    + String userId
    + String orderId
    + Int points
    + LoyaltyType type
    + DateTime createdAt
}

User "1" -- "0..*" Order : places >
User "1" -- "0..*" LoyaltyTransaction : owns >

Order "1" *-- "1..*" OrderItem : contains >
Order "1" -- "0..1" Payment : processed_by >
Order "0..*" -- "0..1" Promotion : applies >

Product "1" -- "0..*" OrderItem : referenced_in >
Order "1" -- "0..1" LoyaltyTransaction : generates >

@enduml