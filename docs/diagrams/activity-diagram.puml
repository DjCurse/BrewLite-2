@startuml activity-diagram
title Activity Diagram - Luồng Đặt Món, Thanh Toán và Xử Lý Đơn Hàng (BrewLite-2)
skinparam backgroundColor white
skinparam shadowing false

|#LightYellow|Khách hàng (Customer)|
start
:Mở ứng dụng BrewLite & xem thực đơn;

|#LightCyan|Frontend (Next.js)|
:Gọi GET /products & hiển thị danh sách món;

|#LightYellow|Khách hàng (Customer)|
:Chọn món, Size (S/M/L), Topping & thêm vào giỏ;
:Nhấn "Tiến hành thanh toán" (/checkout);

|#LightCyan|Frontend (Next.js)|
if (Đã đăng nhập có JWT hợp lệ?) then (Chưa đăng nhập)
  :Chuyển hướng trang Đăng nhập (/login);
  |#LightYellow|Khách hàng (Customer)|
  :Nhập email & mật khẩu;
  |#LightGreen|Backend (NestJS API)|
  :POST /auth/login (kiểm tra bcrypt & cấp JWT);
  |#LightCyan|Frontend (Next.js)|
  :Lưu Access Token & quay lại /checkout;
else (Đã đăng nhập)
endif

|#LightYellow|Khách hàng (Customer)|
:Nhập mã khuyến mãi (nếu có) & chọn MoMo QR / Thẻ;
:Xác nhận đặt đơn và thanh toán;

|#LightGreen|Backend (NestJS API)|
:POST /payments (Bearer JWT + Idempotency-Key);
:Kiểm tra JWT, DTO (ValidationPipe) & Idempotency-Key;

|#LightPink|Payment Gateway|
:Xử lý giao dịch Ví MoMo QR / Thẻ;

if (Kết quả thanh toán?) then (Thất bại)
  :Trả về PAYMENT_FAILED;
  |#LightGreen|Backend (NestJS API)|
  :Trả về 400 Bad Request (không trừ kho);
  |#LightCyan|Frontend (Next.js)|
  :Báo lỗi thanh toán & giữ nguyên giỏ hàng;
  |#LightYellow|Khách hàng (Customer)|
  :Thử thanh toán lại hoặc hủy;
  stop
else (Thành công)
  |#LightPink|Payment Gateway|
  :Trả về SUCCESS & Transaction ID;
  |#LightGreen|Backend (NestJS API)|
  :Mở prisma.$transaction & kiểm tra stockQuantity;
  if (Còn đủ tồn kho?) then (Hết hàng)
    :Rollback Transaction & trả về 400 Bad Request;
    |#LightCyan|Frontend (Next.js)|
    :Thông báo "Sản phẩm không đủ tồn kho";
    stop
  else (Đủ hàng)
    |#LightGreen|Backend (NestJS API)|
    :Trừ stockQuantity, tạo Order (PAID), OrderItem, Payment (SUCCESS);
    :Ghi nhận LoyaltyTransaction & cộng điểm thưởng User;
    :Commit Transaction & trả về 201 Created;
    |#LightCyan|Frontend (Next.js)|
    :Xóa giỏ hàng & mở trang Theo dõi đơn (/orders);
    |#LightYellow|Khách hàng (Customer)|
    :Theo dõi tiến trình (PAID -> CONFIRMED -> PREPARING -> READY -> COMPLETED);
    :Hoặc hủy đơn (CANCELLED) trước khi pha chế -> Hoàn kho & REFUNDED;
    stop
  endif
endif
@enduml